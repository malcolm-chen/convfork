# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# Supabase Cloud (project settings → API keys) — new key format
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx  # client-safe, RLS-bound (replaces anon key)
SUPABASE_SECRET_KEY=sb_secret_xxx            # SERVER ONLY — bypasses RLS (replaces service_role)
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Direct Postgres connection string (backup.py only — Project Settings → Database).
# Not one of the four API keys; grab the session/pooler URI from the dashboard.
SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# Study admin password — unlocks /admin to create users and assign session IDs.
# Participants then log in with userID + sessionID (no email/password).
ADMIN_PASSWORD=change-me

# LiteLLM proxy — you RUN this yourself; it is NOT a hosted service.
#   start it with:  uv run litellm --config litellm-config.yaml
LITELLM_BASE_URL=http://localhost:4000       # where the proxy you start listens
LITELLM_API_KEY=                             # a password YOU invent to protect the proxy.
                                             # Leave blank for localhost-only dev. If set,
                                             # it must equal master_key in litellm-config.yaml.
LLM_MODEL=azure-gpt-4o                        # a model_name alias from litellm-config.yaml

# Provider keys the proxy uses to reach the real model — fill in what you enable
# in litellm-config.yaml. These ARE the keys your provider gave you.
# Azure OpenAI:
AZURE_API_KEY=
AZURE_API_BASE=https://<your-resource>.openai.azure.com
AZURE_API_VERSION=2024-08-01-preview
# Alternates (optional):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AWS S3 (behavior-log sink) — SERVER ONLY
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=convfork-logs
